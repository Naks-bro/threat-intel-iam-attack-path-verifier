# Copy this file to .env and fill it in locally. Never commit .env.
# Do not put a Supabase service-role key, AWS credentials, account IDs, or
# policy documents here. The React app does not read this file.

FYP_IAM_MODE=local_fixtures

# Application traffic. postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
# Use either the direct database host or the session pooler on port 5432.
# Do not put the transaction pooler (port 6543) here.
FYP_DATABASE_URL=

# Optional. Alembic uses this when application traffic and migrations need
# different endpoints. Leave it empty to reuse FYP_DATABASE_URL.
FYP_MIGRATION_DATABASE_URL=

# Optional pair. When both are set, the API prefers the direct URL when an
# IPv6 connection to that host succeeds, and otherwise uses the session URL.
# The session URL must use port 5432, not 6543.
FYP_DATABASE_DIRECT_URL=
FYP_DATABASE_SESSION_URL=

# Optional path to a CA bundle. When this file exists, connections use
# sslmode=verify-full. Managed hosts otherwise require sslmode=require.
FYP_DATABASE_SSLROOTCERT=
